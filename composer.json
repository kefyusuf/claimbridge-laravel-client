{
  "name": "kefyusuf/claimbridge-laravel-client",
  "description": "Laravel-ready PHP client for the claimbridge MEDULA-compatible claim flow — guide-verified contracts from claimbridge-medula-spec.",
  "license": "MIT",
  "type": "library",
  "keywords": ["medula", "sgk", "healthcare", "claims", "laravel"],
  "require": {
    "php": "^8.3",
    "illuminate/support": "^11.0|^12.0",
    "php-http/discovery": "^1.20",
    "psr/http-client": "^1.0",
    "psr/http-factory": "^1.0",
    "psr/log": "^3.0"
  },
  "require-dev": {
    "guzzlehttp/guzzle": "^7.9",
    "guzzlehttp/psr7": "^2.7",
    "laravel/pint": "^1.20",
    "orchestra/testbench": "^9.0|^10.0",
    "phpstan/phpstan": "^2.1",
    "phpstan/phpstan-phpunit": "^2.1",
    "phpunit/phpunit": "^11.5"
  },
  "extra": {
    "laravel": {
      "providers": [
        "ClaimBridge\\Medula\\Laravel\\ClaimBridgeServiceProvider"
      ],
      "aliases": {
        "ClaimBridge": "ClaimBridge\\Medula\\Laravel\\ClaimBridge"
      }
    }
  },
  "autoload": {
    "psr-4": {
      "ClaimBridge\\Medula\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ClaimBridge\\Medula\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "stan": "phpstan analyse --no-progress",
    "cs": "pint --test",
    "cs:fix": "pint",
    "check": [
      "@cs",
      "@stan",
      "@test"
    ]
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable"
}
